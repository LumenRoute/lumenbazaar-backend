{
  "name": "lumenbazaar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm prisma:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm prisma:validate",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:mcp": "tsx apps/mcp-server/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.0.1",
    "@x402/stellar": "2.24.0",
    "bullmq": "5.65.0",
    "fastify": "5.12.1",
    "ioredis": "5.8.2",
    "pino": "10.1.0",
    "prom-client": "15.1.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.11"
  }
}
